@model Artemisia.Models.Produto

@{
    Layout = null;
    ViewData["Title"] = "Editar Produto";
}

<div class="modal-content">
    <div class="modal-header">
        <h5 class="modal-title">Editar Produto</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <form asp-controller="Produto" asp-action="Edit" method="post" enctype="multipart/form-data" id="produtoForm" class="needs-validation" novalidate>
        <div class="modal-body">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ImagemUrl" />

            <div class="mb-3">
                <label class="form-label">Nome</label>
                <input asp-for="Nome" class="form-control" required />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Preço</label>
                <input asp-for="Preco" class="form-control" required />
                <span asp-validation-for="Preco" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Quantidade em estoque</label>
                <input asp-for="QuantidadeEmEstoque" class="form-control" required />
                <span asp-validation-for="QuantidadeEmEstoque" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Categoria</label>
                <select asp-for="CategoriaId" class="form-select" required>
                    <option value="">-- selecione --</option>
                    @if (ViewBag.Categorias != null)
                    {
                        foreach (var c in ViewBag.Categorias)
                        {
                            <option value="@c.Id" selected="@(Model.CategoriaId == c.Id)">@c.Nome</option>
                        }
                    }
                </select>
                 <span asp-validation-for="CategoriaId" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label class="form-label">SubCategoria</label>
                <select asp-for="SubCategoriaId" class="form-select">
                    <option value="">-- selecione --</option>
                    @if (ViewBag.Categorias != null)
                    {
                        foreach (var c in ViewBag.Categorias)
                        {
                            if (c.SubCategorias != null)
                            {
                                foreach (var sc in c.SubCategorias)
                                {
                                    <option value="@sc.Id" selected="@(Model.SubCategoriaId == sc.Id)">&nbsp;&nbsp;- @sc.Nome</option>
                                }
                            }
                        }
                    }
                </select>
                <span asp-validation-for="SubCategoriaId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Descrição</label>
                <textarea asp-for="Descricao" class="form-control"></textarea>
                <span asp-validation-for="Descricao" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Alterar imagem do produto</label>
                <input type="file" name="imagem" class="form-control" accept="image/*" />
                @if (!string.IsNullOrEmpty(Model.ImagemUrl))
                {
                    <div class="mt-2">
                        <small>Imagem atual:</small>
                        <img src="@Model.ImagemUrl" style="max-width: 100px; max-height: 100px;" class="img-thumbnail" />
                    </div>
                }
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-primary">Salvar</button>
        </div>
    </form>
</div>